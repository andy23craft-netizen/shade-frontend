# syntax=docker/dockerfile:1

# FEAT-15 dev-deployment image.
#
# The application is built on the host with `make build`. This image serves
# that optimized Vite `dist/` output only; it does not run Node, Yarn, Vite,
# or a hot-reload development server.
#
# TLS and multi-service orchestration are external to this image.
FROM docker.io/library/nginx:1.31-alpine

WORKDIR /usr/share/nginx/html

COPY ci/nginx.conf /etc/nginx/conf.d/default.conf
COPY ci/container-entrypoint.sh /docker-entrypoint.d/40-shade-runtime-config.sh
COPY dist/ /usr/share/nginx/html/

RUN chmod +x /docker-entrypoint.d/40-shade-runtime-config.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/ \
        && wget -q -O /dev/null http://127.0.0.1:8080/config.js \
        || exit 1
